# Copy to .env and adjust. The service runs offline with the defaults below.
# Never commit a real .env file.

RAG_ENVIRONMENT=development
RAG_LOG_LEVEL=INFO
RAG_HOST=0.0.0.0
RAG_PORT=8000

# Optional gate for /api/v1/*. Leave empty to disable (local demo only).
RAG_API_KEY=

# extractive answers from retrieved text, or openai chat completions.
RAG_CHAT_PROVIDER=extractive
# hash embeddings (offline) or openai embeddings.
RAG_EMBEDDING_PROVIDER=hash
RAG_EMBEDDING_DIMENSION=384

# Required only when a provider above is set to openai.
RAG_OPENAI_API_KEY=
RAG_OPENAI_BASE_URL=https://api.openai.com/v1
RAG_OPENAI_CHAT_MODEL=gpt-4o-mini
RAG_OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# chroma or faiss
RAG_VECTOR_BACKEND=chroma
# hybrid (BM25 + dense RRF) or vector-only
RAG_RETRIEVAL_MODE=hybrid
RAG_VECTOR_PERSIST=true
RAG_COLLECTION_NAME=enterprise_docs

RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=4
RAG_MAX_QUERY_CHARS=4000
RAG_MAX_UPLOAD_BYTES=1000000

# Indexed on startup when the directory exists inside RAG_DATA_DIR.
RAG_AUTO_INGEST_DIR=sample_docs

# Changed if you want a different output-filter canary. 8-64 chars [A-Za-z0-9_-].
RAG_CANARY_TOKEN=RAG_CANARY_7f3a9c

RAG_CORS_ORIGINS=*
